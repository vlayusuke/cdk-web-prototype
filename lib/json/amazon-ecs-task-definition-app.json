[
  {
    "name": "nginx",
    "image": "nginx:1.31.2",
    "repositoryCredentials": {
      "credentialsParameter": "${credentials_parameters_arn}"
    },
    "cpu": 128,
    "memoryReservation": 256,
    "essential": true,
    "readonlyRootFilesystem": true,
    "portMappings": [
      {
        "containerPort": 80,
        "hostPort": 80
      }
    ],
    "environment": [
      {
        "name": "PROJECT",
        "value": "${project}"
      },
      {
        "name": "ENV",
        "value": "${env}"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-region": "${region}",
        "awslogs-group": "${log_group_prefix}-cw-app-nginx-cwlog",
        "awslogs-stream-prefix": "nginx"
      }
    },
    "ulimits": [
      {
        "softLimit": 1024000,
        "hardLimit": 1024000,
        "name": "nofile"
      }
    ]
  },
  {
    "name": "app",
    "image": "php:8.5.7-fpm-bookworm",
    "repositoryCredentials": {
      "credentialsParameter": "${credentials_parameters_arn}"
    },
    "cpu": 128,
    "memoryReservation": 256,
    "essential": true,
    "readonlyRootFilesystem": true,
    "environment": [
      {
        "name": "PROJECT",
        "value": "${project}"
      },
      {
        "name": "ENV",
        "value": "${env}"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-region": "${region}",
        "awslogs-group": "${log_group_prefix}-cw-app-app-cwlog",
        "awslogs-stream-prefix": "app"
      }
    },
    "ulimits": [
      {
        "softLimit": 1024000,
        "hardLimit": 1024000,
        "name": "nofile"
      }
    ]
  }
]
